rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.email == 'cyber924@naver.com' || request.auth.token.email == 'cyber924@gmail.com');
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /saved_posts/{postId} {
      allow read, write: if true;
    }

    match /saved_shorts/{shortsId} {
      allow read, write: if true;
    }

    match /saved_sns/{snsId} {
      allow read, write: if true;
    }

    match /shared_assets/{assetId} {
      allow read, write: if true;
    }

    match /marketing_channels/{channelId} {
      allow read, write: if true;
    }

    match /scheduled_reservations/{reservationId} {
      allow read, write: if true;
    }

    match /cached_trends/{docId} {
      allow read, write: if true;
    }

    match /post_images/{imageId} {
      allow read, write: if true;
    }
  }
}
